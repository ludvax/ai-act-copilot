# Copy to `.env` and fill in what you have. Empty values are ignored.

# --- LLM (required from milestone M3) ----------------------------------------
ANTHROPIC_API_KEY=
# AIACT_LLM_MODEL=claude-opus-5

# --- Observability: Langfuse (optional — tracing is disabled without keys) ----
# cloud.langfuse.com is the EU region; use https://us.cloud.langfuse.com for the US.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# AIACT_TRACING_ENABLED=true

# --- Application ---------------------------------------------------------------
# AIACT_DATA_DIR=data
# AIACT_LOG_LEVEL=INFO
